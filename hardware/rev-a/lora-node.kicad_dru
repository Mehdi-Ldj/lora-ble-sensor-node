(version 1)
(rule "RF neck escape"
	(constraint clearance (min 0.14mm))
	(condition "A.NetName == '/MCU/ANT'")
)

(rule "U3 VIP via size"
    (constraint via_diameter (min 0.35mm))
    (constraint hole_size (min 0.2mm))
    (constraint annular_width (min 0.075mm))
    (condition "A.Type == 'Via' && A.insideArea('U3_VIP')")
)

(rule "U3 VIP clearance"
    (constraint clearance (min 0.15mm))
    (condition "A.Type == 'Via' && A.insideArea('U3_VIP')")
)

(rule "U3 VIP hole clearance"
    (constraint hole_clearance (min 0.225mm))
    (condition "A.Type == 'Via' && A.insideArea('U3_VIP')")
)